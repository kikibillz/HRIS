# Existing SQLite directory; preserve it across restarts and updates.
# HRIS_DATA_DIR=/absolute/path/to/existing/data
# Enable only for first-administrator setup on an empty/private workspace.
# HRIS_ALLOW_SETUP=1
# Optional generated policy answers. Leave unset to use company policy search.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=
# Comma-separated company IDs explicitly enabled by the server operator.
# AI_ENABLED_COMPANY_IDS=

# Operator backup CLI only: supply privately per session, then unset.
# HRIS_BACKUP_PASSPHRASE=

# Production: exact public HTTPS origin, no trailing slash.
# HRIS_PUBLIC_ORIGIN=https://hr.example.com
# HRIS_DEPLOYMENT=production
