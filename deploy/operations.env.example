# Example for a standalone Linux host. Adapt paths and service account before installation.
# Keep the real file root-owned, mode 0600; passphrase is in a separate service-owned file.
HRIS_DATA_DIR=/var/lib/hris
HRIS_BACKUP_DIR=/mnt/hris-backups/peopleos
HRIS_BACKUP_MOUNT=/mnt/hris-backups
HRIS_BACKUP_KEY_FILE=/etc/peopleos/backup.key
HRIS_BACKUP_RETENTION_DAYS=30
HRIS_BACKUP_MAX_AGE_HOURS=36
HRIS_MIN_FREE_BYTES=1073741824
HRIS_MONITOR_ORIGIN=http://127.0.0.1:3000
