[Unit]
Description=PeopleOS encrypted backup and isolated restore drill
RequiresMountsFor=/mnt/hris-backups

[Service]
Type=oneshot
User=hris
Group=hris
WorkingDirectory=/opt/peopleos
EnvironmentFile=/etc/peopleos/operations.env
ExecStart=/usr/bin/node /opt/peopleos/scripts/backup-maintenance.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/opt/peopleos
ReadWritePaths=/var/lib/hris /mnt/hris-backups
TimeoutStartSec=1h
